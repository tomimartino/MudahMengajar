# Supabase — salin file ini menjadi .env.local dan isi dengan kredensial project kamu
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# HANYA untuk server (jangan pernah pakai prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# URL aplikasi (untuk redirect email auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Kunci publik VAPID untuk web push — generate: npx web-push generate-vapid-keys
# (kunci privat VAPID masuk ke secret Edge Function: VAPID_PRIVATE_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
